# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/blackcoffer_insights
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blackcoffer_insights
MONGO_URI=mongodb://127.0.0.1:27017/blackcoffer_insights

# When MONGO_URI is unreachable in development, fall back to an in-memory
# MongoDB instance (mongodb-memory-server) so the app runs out of the box.
# Set to "false" to disable the fallback and fail hard instead.
ALLOW_MEMORY_FALLBACK=true

# Seed the database automatically on boot when the collection is empty.
AUTO_SEED=true

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:5173
